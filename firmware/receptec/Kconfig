mainmenu "RECEPTEC firmware"

config RECEPTEC_UWB_RADIO
	bool "Initialize the QM33120W radio and enable UWB peer/SYNC shell"
	default n
	help
	  Initialize the QM33120W/DW3720 over SPI and configure the shared
	  RECEPTEC/COLETEC v1.0 PHY. The `uwb peer` shell commands manage the
	  volatile four-slot software allow-list; `uwb sync <slot>` sends one
	  addressed SYNC and waits for the matching ACK. It does not autostart RF.

source "Kconfig.zephyr"
