/* RECEPTEC carrier uses the Murata LBUA5QJ2AB-828 (nRF52840 + QM33120W). */

/* Pi GPIO14/TXD0 -> P0.05 (nRF RX); Pi GPIO15/RXD0 <- P0.06 (nRF TX). */
&gpiote {
	status = "okay";
};

&gpio0 {
	status = "okay";
};

&gpio1 {
	status = "okay";
};

&uart1 {
	status = "okay";
	current-speed = <115200>;
	pinctrl-0 = <&receptec_uart_default>;
	pinctrl-1 = <&receptec_uart_sleep>;
	pinctrl-names = "default", "sleep";
};

/ {
	chosen {
		zephyr,console = &uart1;
		zephyr,shell-uart = &uart1;
	};
};

&pinctrl {
	receptec_uart_default: receptec_uart_default {
		group1 {
			psels = <NRF_PSEL(UART_RX, 0, 5)>,
				<NRF_PSEL(UART_TX, 0, 6)>;
		};
	};

	receptec_uart_sleep: receptec_uart_sleep {
		group1 {
			psels = <NRF_PSEL(UART_RX, 0, 5)>,
				<NRF_PSEL(UART_TX, 0, 6)>;
			low-power-enable;
		};
	};

	receptec_uwb_spi_default: receptec_uwb_spi_default {
		group1 {
			psels = <NRF_PSEL(SPIM_SCK, 0, 16)>,
				<NRF_PSEL(SPIM_MOSI, 0, 17)>,
				<NRF_PSEL(SPIM_MISO, 0, 23)>;
		};
	};

	receptec_uwb_spi_sleep: receptec_uwb_spi_sleep {
		group1 {
			psels = <NRF_PSEL(SPIM_SCK, 0, 16)>,
				<NRF_PSEL(SPIM_MOSI, 0, 17)>,
				<NRF_PSEL(SPIM_MISO, 0, 23)>;
			low-power-enable;
		};
	};
};

&spi2 {
	status = "disabled";
};

&spi3 {
	status = "okay";
	compatible = "nordic,nrf-spim";
	pinctrl-0 = <&receptec_uwb_spi_default>;
	pinctrl-1 = <&receptec_uwb_spi_sleep>;
	pinctrl-names = "default", "sleep";
	cs-gpios = <&gpio0 20 GPIO_ACTIVE_LOW>;

	uwb_radio: qm33120w@0 {
		compatible = "qorvo,qm33120w";
		reg = <0>;
		spi-max-frequency = <32000000>;
		irq-gpios = <&gpio0 25 GPIO_ACTIVE_HIGH>;
		reset-gpios = <&gpio0 15 GPIO_ACTIVE_LOW>;
		wakeup-gpios = <&gpio1 2 GPIO_ACTIVE_HIGH>;
	};
};
