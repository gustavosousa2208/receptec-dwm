mainmenu "RECEPTEC DWM3001C firmware"

config RECEPTEC_TEST_DROP_ACKS
	int "ACKs to drop at the start of each SYNC transaction"
	range 0 2
	default 0
	help
	  Test-only fault injection. A value of 1 or 2 makes the COLETEC skip
	  that many valid SYNC responses per new sequence so deterministic retry
	  offsets can be verified. Production and normal bench builds use zero.

source "Kconfig.zephyr"
